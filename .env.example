# ------------------------------------------------------------------
# mikarpa — variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# En Vercel: Project → Settings → Environment Variables.
# ------------------------------------------------------------------

# --- Base de datos (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mikarpa

# --- Auth.js v5 ---
# Genera el secreto con: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Alias compatible con configuraciones v4 (el código acepta cualquiera de los dos)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Imágenes: Cloudinary (plan free) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternativa: Vercel Blob (si no usas Cloudinary)
# BLOB_READ_WRITE_TOKEN=

# --- Pagos: Mercado Pago (Perú / LATAM, Fase 3) ---
# Credenciales de la aplicación Marketplace en mercadopago.com.pe/developers
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:3000/api/payments/mercadopago/callback
MP_WEBHOOK_SECRET=
# Clave de 32 bytes en base64 para cifrar tokens OAuth por tienda (AES-256-GCM)
# Genera con: openssl rand -base64 32
PAYMENT_TOKEN_KEY=

# --- Pasarelas alternativas (opcionales) ---
# Culqi (Perú: tarjetas, Yape, PagoEfectivo, agentes)
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Stripe (solo países donde opera; no Perú)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email transaccional (opcional, Fase 2) ---
RESEND_API_KEY=
EMAIL_FROM="mikarpa <no-reply@mikarpa.xyz>"

# --- Seed (solo local o una única vez en producción) ---
SEED_SUPERADMIN_EMAIL=admin@mikarpa.xyz
SEED_SUPERADMIN_PASSWORD=CambiarEstaClave123!
SEED_OWNER_EMAIL=demo@mikarpa.xyz
SEED_OWNER_PASSWORD=demo1234
